{
  "name": "apextrace-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit"
  },
  "dependencies": {
    "plotly.js": "3.7.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-plotly.js": "^4.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/react-plotly.js": "^2.6.3",
    "@vitejs/plugin-react": "^6.0.0",
    "axe-core": "4.13.0",
    "typescript": "~5.9.0",
    "vite": "^8.1.0"
  },
  "comments": {
    "plotly.js": "Pinned exactly, not caret-ranged. The API serves figures built by plotly.py 6.9.0, which bundles plotly.js 3.7.0; a client on a different major silently fails to render traces whose schema it does not know. Bump both together or neither."
  }
}
